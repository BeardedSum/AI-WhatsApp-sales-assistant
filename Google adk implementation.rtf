\f2\b0\fs26 \cf0 # src/services/adk-orchestrator.service.ts (TypeScript wrapper)\
import \{ spawn \} from 'child_process';\
\
export class ADKOrchestratorService \{\
  async processMessage(params: \{\
    conversation_id: string;\
    message: string;\
    business_id: string;\
  \}): Promise<\{\
    response?: string;\
    confidence: number;\
    status: 'sent' | 'escalated' | 'pending_confirmation';\
    requires_confirmation?: boolean;\
  \}> \{\
    \
    // Call Python ADK script\
    const result = await this.runPythonADK(\{\
      conversation_id: params.conversation_id,\
      customer_message: params.message,\
      business_id: params.business_id\
    \});\
    \
    return result;\
  \}\
  \
  private async runPythonADK(data: any): Promise<any> \{\
    return new Promise((resolve, reject) => \{\
      const python = spawn('python3', [\
        'adk/main.py',\
        '--action', 'process_message',\
        '--data', JSON.stringify(data)\
      ]);\
      \
      let output = '';\
      \
      python.stdout.on('data', (data) => \{\
        output += data.toString();\
      \});\
      \
      python.on('close', (code) => \{\
        if (code === 0) \{\
          resolve(JSON.parse(output));\
        \} else \{\
          reject(new Error(`ADK process failed: $\{code\}`));\
        \}\
      \});\
    \});\
  \}\
\}\
