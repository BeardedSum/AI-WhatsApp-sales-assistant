async def process_message_with_confirmation(data):\
    result = runner.run_session(user_input, initial_state)\
    \
    # Check if confirmation is needed\
    if result.requires_confirmation:\
        # Store pending state\
        redis.set(\
            f"pending:\{result.confirmation_id\}",\
            json.dumps(result.state),\
            ex=3600  # 1 hour expiry\
        )\
        \
        # Send to business owner dashboard\
        await notify_owner_for_confirmation(\{\
            "confirmation_id": result.confirmation_id,\
            "action": result.confirmation_action,\
            "details": result.confirmation_details\
        \})\
        \
        return \{"status": "pending_confirmation"\}\
    \
    # Normal flow\
    return \{"status": "completed"\}\
\
# Separate endpoint for approvals\
@app.post("/api/confirmations/\{confirmation_id\}/approve")\
async def approve_confirmation(confirmation_id: str):\
    # Retrieve pending state\
    state = json.loads(redis.get(f"pending:\{confirmation_id\}"))\
    \
    # Resume execution with approval\
    result = runner.resume_session(\
        confirmation_id=confirmation_id,\
        approved=True,\
        state=state\
    )\
    \
    return \{"status": "approved", "result": result\}\
