\fs28 \cf0 1. Intent Classifier Agent (Fast - Gemini Flash)\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 from google.adk.agents import LlmAgent\
\
intent_classifier = LlmAgent(\
    model="gemini-2.5-flash",\
    name="IntentClassifier",\
    description="Classifies customer intent from their message",\
    instruction="""Analyze the customer's message and classify their intent.\
    \
    Intent Categories:\
    - PRODUCT_INQUIRY: Asking about products, prices, availability\
    - ORDER_PLACEMENT: Ready to buy, wants to place order\
    - SUPPORT: Has issue, complaint, or needs help\
    - GENERAL_QUESTION: FAQs about business (location, hours, policies)\
    - CHITCHAT: Greeting, casual conversation\
    \
    Return ONLY the intent category, nothing else.\
    """,\
    output_key="intent"  # Save to state\
)\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 2. Context Gatherer Agent (Parallel Execution)\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 from google.adk.agents import ParallelAgent, LlmAgent\
\
# Sub-agent for file search\
file_searcher = LlmAgent(\
    model="gemini-2.5-flash",\
    name="FileSearcher",\
    instruction="""Extract search keywords from the customer message: \{customer_message\}\
    \
    Then use search_business_documents tool to find relevant info.\
    Return what you found.""",\
    tools=[file_search_tool],\
    output_key="file_search_results"\
)\
\
# Sub-agent for product lookup\
product_searcher = LlmAgent(\
    model="gemini-2.5-flash",\
    name="ProductSearcher",\
    instruction="""If customer message mentions a product: \{customer_message\}\
    \
    Use lookup_products tool to find matching products.\
    Return product details.""",\
    tools=[product_lookup_tool],\
    output_key="product_results"\
)\
\
# Sub-agent for FAQ lookup\
faq_searcher = LlmAgent(\
    model="gemini-2.5-flash",\
    name="FAQSearcher",\
    instruction="""Check if customer question: \{customer_message\}\
    \
    matches any FAQs using lookup_faqs tool.\
    Return matching FAQs.""",\
    tools=[faq_lookup_tool],\
    output_key="faq_results"\
)\
\
# Run all three searches in parallel\
context_gatherer = ParallelAgent(\
    name="ContextGatherer",\
    sub_agents=[file_searcher, product_searcher, faq_searcher]\
)\
\pard\pardeftab720\sa280\partightenfactor0

