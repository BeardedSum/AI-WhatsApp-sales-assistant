\f2\b0\fs26 \cf0 # adk/main.py\
import sys\
import json\
import argparse\
from google.adk.runners import Runner\
from agents import whatsapp_assistant_workflow\
from database import db\
\
def process_message(data: dict) -> dict:\
    """Main ADK processing function."""\
    \
    # Extract parameters\
    customer_message = data["customer_message"]\
    conversation_id = data["conversation_id"]\
    business_id = data["business_id"]\
    \
    # Load context\
    business = db.get_business(business_id)\
    conversation = db.get_conversation(conversation_id)\
    history = db.get_last_n_messages(conversation_id, 5)\
    \
    # Prepare state\
    initial_state = \{\
        "customer_message": customer_message,\
        "conversation_id": conversation_id,\
        "business_id": business_id,\
        "business_name": business.name,\
        "ai_tone": business.ai_tone,\
        "business_location": business.location,\
        "products_summary": get_products_summary(business_id),\
        "conversation_history": format_conversation_history(history)\
    \}\
    \
    # Run workflow\
    runner = Runner(\
        agent=whatsapp_assistant_workflow,\
        app_name="whatsapp_ai_assistant"\
    )\
    \
    result = runner.run_session(\
        user_input="Process customer message",\
        initial_state=initial_state\
    )\
    \
    # Process results\
    ai_response = result.state.get("ai_response")\
    confidence_score = float(result.state.get("confidence_score", 0))\
    \
    # Decision\
    if result.requires_confirmation:\
        return \{\
            "status": "pending_confirmation",\
            "requires_confirmation": True,\
            "confirmation_id": result.confirmation_id,\
            "confidence": confidence_score\
        \}\
    \
    if confidence_score >= 0.85:\
        # Send message\
        send_whatsapp_message(\
            to=conversation.customer.whatsapp_number,\
            message=ai_response\
        )\
        \
        return \{\
            "status": "sent",\
            "response": ai_response,\
            "confidence": confidence_score\
        \}\
    else:\
        # Escalation was handled by workflow\
        return \{\
            "status": "escalated",\
            "confidence": confidence_score\
        \}\
\
if __name__ == "__main__":\
    parser = argparse.ArgumentParser()\
    parser.add_argument("--action", required=True)\
    parser.add_argument("--data", required=True)\
    \
    args = parser.parse_args()\
    data = json.loads(args.data)\
    \
    if args.action == "process_message":\
        result = process_message(data)\
        print(json.dumps(result))\
    else:\
        print(json.dumps(\{"error": "Unknown action"\}))\
        sys.exit(1)\
