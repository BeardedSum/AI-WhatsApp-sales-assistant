def should_confirm_escalation(\
    conversation_id: str,\
    reason: str,\
    holding_message: str\
) -> bool:\
    """Determine if escalation needs human approval."""\
    \
    # Get conversation context\
    conversation = db.get_conversation(conversation_id)\
    \
    # Auto-escalate if customer is VIP or urgent\
    if conversation.customer.tags == "vip":\
        return False  # No confirmation needed\
    \
    # Auto-escalate for complaints\
    if "complaint" in reason.lower():\
        return False\
    \
    # Otherwise require confirmation\
    return True\
\
