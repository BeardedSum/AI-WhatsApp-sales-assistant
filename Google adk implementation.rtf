## \uc0\u55357 \u57056 \u65039  Tool Definitions\
\
### 1. File Search Tool\
\
```python\
from google.adk.tools import FunctionTool, ToolContext\
from typing import List, Dict\
import json\
\
def search_business_documents(\
    query: str,\
    business_id: str,\
    tool_context: ToolContext\
) -> Dict:\
    """\
    Search the business's knowledge base in Google Drive for relevant information.\
    \
    Args:\
        query: Natural language search query (e.g., "blue dress price")\
        business_id: UUID of the business\
        \
    Returns:\
        Dict with documents found and their content snippets\
    """\
    # Get business from database\
    business = db.get_business(business_id)\
    \
    if not business.knowledge_base_google_drive_folder_id:\
        return \{\
            "success": False,\
            "message": "No knowledge base configured",\
            "documents": []\
        \}\
    \
    # Query Google File Search API\
    search_results = google_file_search.search(\
        query=query,\
        folder_id=business.knowledge_base_google_drive_folder_id,\
        max_results=3\
    )\
    \
    return \{\
        "success": True,\
        "documents": [\
            \{\
                "title": doc.name,\
                "snippet": doc.content_snippet,\
                "url": doc.url\
            \}\
            for doc in search_results\
        ],\
        "count": len(search_results)\
    \}\
\
# Wrap as ADK tool\
file_search_tool = FunctionTool(search_business_documents)\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 2. Product Lookup Tool\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 def lookup_products(\
    search_term: str,\
    business_id: str,\
    tool_context: ToolContext\
) -> Dict:\
    """\
    Search for products in the business catalog.\
    \
    Args:\
        search_term: Product name, category, or description keyword\
        business_id: UUID of the business\
        \
    Returns:\
        Dict with matching products and their details\
    """\
    products = db.search_products(\
        business_id=business_id,\
        search_term=search_term,\
        limit=5\
    )\
    \
    if not products:\
        return \{\
            "success": False,\
            "message": f"No products found matching '\{search_term\}'",\
            "products": []\
        \}\
    \
    return \{\
        "success": True,\
        "products": [\
            \{\
                "name": p.name,\
                "description": p.description,\
                "price": float(p.price),\
                "currency": p.currency,\
                "in_stock": p.stock_quantity > 0,\
                "stock_quantity": p.stock_quantity\
            \}\
            for p in products\
        ],\
        "count": len(products)\
    \}\
\
product_lookup_tool = FunctionTool(lookup_products)\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 3. FAQ Lookup Tool\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 def lookup_faqs(\
    question: str,\
    business_id: str,\
    tool_context: ToolContext\
) -> Dict:\
    """\
    Find relevant FAQs for the customer's question.\
    \
    Args:\
        question: Customer's question\
        business_id: UUID of the business\
        \
    Returns:\
        Dict with matching FAQs\
    """\
    faqs = db.search_faqs(\
        business_id=business_id,\
        question=question,\
        limit=3\
    )\
    \
    if not faqs:\
        return \{\
            "success": False,\
            "message": "No FAQs found",\
            "faqs": []\
        \}\
    \
    # Update times_asked counter\
    for faq in faqs:\
        db.increment_faq_counter(faq.id)\
    \
    return \{\
        "success": True,\
        "faqs": [\
            \{\
                "question": faq.question,\
                "answer": faq.answer\
            \}\
            for faq in faqs\
        ]\
    \}\
\
faq_lookup_tool = FunctionTool(lookup_faqs)\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 4. Send WhatsApp Message Tool\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 def send_whatsapp_message(\
    to: str,\
    message: str,\
    tool_context: ToolContext\
) -> Dict:\
    """\
    Send a WhatsApp message to a customer.\
    \
    Args:\
        to: Customer's WhatsApp number (without 'whatsapp:' prefix)\
        message: Message content to send\
        \
    Returns:\
        Dict with message ID and delivery status\
    """\
    try:\
        message_id = twilio_client.messages.create(\
            from_=f"whatsapp:\{WHATSAPP_NUMBER\}",\
            to=f"whatsapp:\{to\}",\
            body=message\
        ).sid\
        \
        return \{\
            "success": True,\
            "message_id": message_id,\
            "status": "sent"\
        \}\
    except Exception as e:\
        return \{\
            "success": False,\
            "error": str(e)\
        \}\
\
send_message_tool = FunctionTool(send_whatsapp_message)\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 5. Escalate to Human Tool (with Confirmation)\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 def escalate_conversation(\
    conversation_id: str,\
    reason: str,\
    holding_message: str,\
    tool_context: ToolContext\
) -> Dict:\
    """\
    Escalate conversation to business owner. Requires confirmation.\
    \
    Args:\
        conversation_id: UUID of the conversation\
        reason: Why escalation is needed\
        holding_message: Message to send to customer while waiting\
        \
    Returns:\
        Dict with escalation status\
    """\
    # Update conversation in database\
    db.escalate_conversation(conversation_id, reason)\
    \
    # Get conversation details\
    conversation = db.get_conversation(conversation_id)\
    customer = conversation.customer\
    business = conversation.business\
    \
    # Notify business owner\
    notification_service.notify_owner(\
        business_id=business.id,\
        title="Conversation Escalated",\
        message=f"Customer \{customer.whatsapp_number\} needs assistance",\
        conversation_id=conversation_id\
    )\
    \
    # Send holding message to customer\
    send_whatsapp_message(\
        to=customer.whatsapp_number,\
        message=holding_message,\
        tool_context=tool_context\
    )\
    \
    return \{\
        "success": True,\
        "conversation_id": conversation_id,\
        "status": "escalated",\
        "reason": reason\
    \}\
\
# Confirmation function - only escalate on low confidence\
def should_confirm_escalation(\
    conversation_id: str,\
    reason: str,\
    holding_message: str\
) -> bool:\
    """Return True if escalation needs confirmation."""\
    # For now, always confirm escalations\
    return True\
\
escalate_tool = FunctionTool(\
    escalate_conversation,\
    require_confirmation=should_confirm_escalation\
)\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 6. Schedule Follow-up Tool\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 def schedule_followup(\
    customer_id: str,\
    message_template: str,\
    hours_delay: int,\
    tool_context: ToolContext\
) -> Dict:\
    """\
    Schedule a follow-up message to customer.\
    \
    Args:\
        customer_id: UUID of the customer\
        message_template: Message to send later\
        hours_delay: Hours to wait before sending (24, 48, 72)\
        \
    Returns:\
        Dict with scheduled follow-up ID\
    """\
    from datetime import datetime, timedelta\
    \
    scheduled_time = datetime.utcnow() + timedelta(hours=hours_delay)\
    \
    followup_id = db.create_followup(\
        customer_id=customer_id,\
        message_template=message_template,\
        scheduled_for=scheduled_time\
    )\
    \
    # Add to queue\
    followup_queue.add_job(\
        followup_id=followup_id,\
        scheduled_for=scheduled_time\
    )\
    \
    return \{\
        "success": True,\
        "followup_id": followup_id,\
        "scheduled_for": scheduled_time.isoformat()\
    \}\
\
schedule_followup_tool = FunctionTool(schedule_followup)\
\pard\pardeftab720\partightenfactor0

