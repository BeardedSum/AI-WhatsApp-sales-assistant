\fs28 \cf0 Main Sequential Workflow\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 from google.adk.agents import SequentialAgent\
\
whatsapp_assistant_workflow = SequentialAgent(\
    name="WhatsAppAssistantWorkflow",\
    sub_agents=[\
        # Step 1: Classify intent (fast)\
        intent_classifier,\
        \
        # Step 2: Gather context (parallel searches)\
        context_gatherer,\
        \
        # Step 3: Generate response (quality)\
        response_generator_claude,  # or response_generator_gemini\
        \
        # Step 4: Score confidence\
        confidence_scorer,\
        \
        # Step 5: Either send or escalate\
        # This is handled by decision logic (see below)\
    ]\
)\
\pard\pardeftab720\sa280\partightenfactor0

\f1\b\fs28 \cf0 Decision Logic After Workflow\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 from google.adk.runners import Runner\
\
def process_customer_message(\
    customer_message: str,\
    conversation_id: str,\
    business_id: str\
):\
    """Main entry point for processing customer messages."""\
    \
    # Load business context\
    business = db.get_business(business_id)\
    conversation = db.get_conversation(conversation_id)\
    history = db.get_last_n_messages(conversation_id, 5)\
    \
    # Prepare state\
    initial_state = \{\
        "customer_message": customer_message,\
        "conversation_id": conversation_id,\
        "business_id": business_id,\
        "business_name": business.name,\
        "ai_tone": business.ai_tone,\
        "business_location": business.location,\
        "products_summary": get_products_summary(business_id),\
        "conversation_history": format_conversation_history(history)\
    \}\
    \
    # Run workflow\
    runner = Runner(\
        agent=whatsapp_assistant_workflow,\
        app_name="whatsapp_ai_assistant"\
    )\
    \
    result = runner.run_session(\
        user_input="Process this customer message",\
        initial_state=initial_state\
    )\
    \
    # Extract results from state\
    ai_response = result.state.get("ai_response")\
    confidence_score = float(result.state.get("confidence_score", 0))\
    \
    # Decision logic\
    if confidence_score >= 0.85:\
        # High confidence - send response\
        send_whatsapp_message(\
            to=conversation.customer.whatsapp_number,\
            message=ai_response,\
            tool_context=None\
        )\
        \
        # Save to database\
        db.save_message(\
            conversation_id=conversation_id,\
            sender_type="ai",\
            content=ai_response,\
            ai_confidence_score=confidence_score\
        )\
        \
        return \{\
            "status": "sent",\
            "confidence": confidence_score,\
            "response": ai_response\
        \}\
    else:\
        # Low confidence - escalate\
        escalation_runner = Runner(\
            agent=escalation_handler,\
            app_name="whatsapp_ai_assistant"\
        )\
        \
        escalation_result = escalation_runner.run_session(\
            user_input="Escalate this conversation",\
            initial_state=\{\
                **initial_state,\
                "ai_response": ai_response,\
                "confidence_score": confidence_score\
            \}\
        )\
        \
        return \{\
            "status": "escalated",\
            "confidence": confidence_score,\
            "reason": "Low AI confidence"\
        \}\
\pard\pardeftab720\partightenfactor0

