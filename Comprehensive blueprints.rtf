\f2\b0\fs26 \cf0 \strokec2 import \{ anthropic, CLAUDE_MODEL, MAX_TOKENS \} from '../config/claude';\
import \{ BusinessContext, Message as MessageType \} from '../types';\
import \{ logger \} from '../utils/logger';\
\
export class ClaudeService \{\
  async generateResponse(params: \{\
    userMessage: string;\
    businessContext: BusinessContext;\
    conversationHistory: MessageType[];\
    fileSearchResults?: any[];\
  \}): Promise<\{\
    message: string;\
    confidence: number;\
    usage: any;\
  \}> \{\
    const startTime = Date.now();\
    \
    const systemPrompt = this.buildSystemPrompt(params.businessContext);\
    const userPrompt = this.buildUserPrompt(\
      params.userMessage,\
      params.conversationHistory,\
      params.fileSearchResults\
    );\
    \
    try \{\
      const response = await anthropic.messages.create(\{\
        model: CLAUDE_MODEL,\
        max_tokens: MAX_TOKENS,\
        system: systemPrompt,\
        messages: [\
          ...this.formatConversationHistory(params.conversationHistory),\
          \{ role: 'user', content: userPrompt \}\
        ]\
      \});\
      \
      const responseTime = Date.now() - startTime;\
      const message = response.content[0].text;\
      const confidence = this.calculateConfidence(message);\
      \
      logger.info('Claude response generated', \{\
        confidence,\
        responseTime,\
        tokens: response.usage.total_tokens\
      \});\
      \
      return \{\
        message,\
        confidence,\
        usage: response.usage\
      \};\
    \} catch (error) \{\
      logger.error('Claude API error', \{ error \});\
      throw error;\
    \}\
  \}\
\
  private buildSystemPrompt(businessContext: BusinessContext): string \{\
    return `\
You are an AI sales assistant for $\{businessContext.name\}.\
\
TONE: $\{businessContext.ai_tone\}\
\
BUSINESS INFO:\
- Location: $\{businessContext.location\}\
- WhatsApp: $\{businessContext.whatsapp_number\}\
- Products: $\{businessContext.products.map(p => `$\{p.name\} - \uc0\u8358 $\{p.price.toLocaleString()\}`).join(', ')\}\
\
POLICIES:\
$\{JSON.stringify(businessContext.policies, null, 2)\}\
\
INSTRUCTIONS:\
- Be helpful and friendly\
- Answer product questions accurately using the provided context\
- Take orders when requested (collect: name, address, phone, items)\
- If unsure about anything, say "Let me connect you with my manager"\
- Never make up product information not in your context\
- Use Nigerian English naturally\
- Keep responses concise (2-3 sentences unless detailed explanation needed)\
`;\
  \}\
\
  private buildUserPrompt(\
    userMessage: string,\
    conversationHistory: MessageType[],\
    fileSearchResults?: any[]\
  ): string \{\
    let prompt = '';\
    \
    if (fileSearchResults && fileSearchResults.length > 0) \{\
      prompt += 'RETRIEVED DOCUMENTS:\\n';\
      fileSearchResults.forEach(doc => \{\
        prompt += `- $\{doc.title\}: $\{doc.snippet\}\\n`;\
      \});\
      prompt += '\\n';\
    \}\
    \
    prompt += `CUSTOMER QUESTION: $\{userMessage\}`;\
    \
    return prompt;\
  \}\
\
  private formatConversationHistory(messages: MessageType[]): any[] \{\
    return messages.slice(-5).map(msg => (\{\
      role: msg.sender_type === 'customer' ? 'user' : 'assistant',\
      content: msg.content\
    \}));\
  \}\
\
  private calculateConfidence(responseText: string): number \{\
    const uncertainPhrases = [\
      "i'm not sure",\
      "let me check",\
      "i don't know",\
      "might be",\
      "possibly",\
      "connect you with my manager",\
      "let me connect you"\
    ];\
    \
    const lowerText = responseText.toLowerCase();\
    const hasUncertainty = uncertainPhrases.some(phrase => lowerText.includes(phrase));\
    \
    return hasUncertainty ? 0.7 : 0.95;\
  \}\
\}\
