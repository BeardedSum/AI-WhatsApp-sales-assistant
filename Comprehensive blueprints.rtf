\f2\fs26 \cf0 \strokec2 class FileSearchService \{\
  async searchBusinessDocuments(query: string, businessId: string) \{\
    const business = await this.businessRepo.findOne(\{ \
      where: \{ id: businessId \} \
    \});\
    \
    if (!business.knowledge_base_google_drive_folder_id) \{\
      return null;\
    \}\
    \
    // Query Google File Search API\
    const searchResults = await googleFileSearchAPI.search(\{\
      query: query,\
      folder_id: business.knowledge_base_google_drive_folder_id,\
      max_results: 3\
    \});\
    \
    return searchResults.documents.map(doc => (\{\
      title: doc.name,\
      snippet: doc.content_snippet,\
      url: doc.url\
    \}));\
  \}\
  \
  async indexDocument(fileBuffer: Buffer, fileName: string, businessId: string) \{\
    const business = await this.businessRepo.findOne(\{ \
      where: \{ id: businessId \} \
    \});\
    \
    // Upload to Google Drive\
    const file = await googleDrive.files.create(\{\
      requestBody: \{\
        name: fileName,\
        parents: [business.knowledge_base_google_drive_folder_id]\
      \},\
      media: \{\
        body: fileBuffer\
      \}\
    \});\
    \
    // Trigger File Search indexing\
    await googleFileSearchAPI.index(\{\
      file_id: file.data.id\
    \});\
    \
    return file.data.id;\
  \}\
\}\
