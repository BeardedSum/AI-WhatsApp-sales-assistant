\f2\b0\fs26 \cf0 \strokec2 import \{ Request, Response \} from 'express';\
import \{ WhatsAppService \} from '../services/whatsapp.service';\
import \{ ConversationService \} from '../services/conversation.service';\
import \{ AIOrchestrator Service \} from '../services/ai-orchestrator.service';\
import \{ logger \} from '../utils/logger';\
\
const whatsappService = new WhatsAppService();\
const conversationService = new ConversationService();\
const aiOrchestratorService = new AIOrchestratorService();\
\
export class WebhookController \{\
  async handleIncomingMessage(req: Request, res: Response) \{\
    // 1. Verify signature\
    if (!whatsappService.verifyWebhookSignature(req)) \{\
      logger.warn('Invalid webhook signature');\
      return res.status(403).send('Forbidden');\
    \}\
\
    // 2. Parse payload\
    const \{ From: from, Body: body, MessageSid: messageId \} = req.body;\
    const customerNumber = from.replace('whatsapp:', '');\
\
    logger.info('Incoming WhatsApp message', \{ from: customerNumber, messageId \});\
\
    // 3. Acknowledge immediately (WhatsApp requires response within 15s)\
    res.status(200).send('OK');\
\
    // 4. Process asynchronously\
    this.processMessageAsync(customerNumber, body, messageId).catch(error => \{\
      logger.error('Message processing failed', \{ customerNumber, error \});\
    \});\
  \}\
\
  private async processMessageAsync(from: string, body: string, messageId: string) \{\
    try \{\
      // Load conversation context\
      const conversation = await conversationService.loadOrCreateConversation(from);\
\
      // Check if escalated to human\
      if (conversation.escalated_to_human) \{\
        // Notify owner, don't respond with AI\
        await conversationService.notifyOwnerOfNewMessage(conversation.id, body);\
        return;\
      \}\
\
      // Save customer message\
      await conversationService.saveMessage(conversation.id, 'customer', body);\
\
      // Send to AI orchestrator (Google ADK + Claude)\
      const aiResponse = await aiOrchestratorService.processMessage(\{\
        conversation_id: conversation.id,\
        message: body,\
        business_id: conversation.business_id\
      \});\
\
      // Check confidence and respond or escalate\
      if (aiResponse.confidence > 0.85) \{\
        await whatsappService.sendMessage(from, aiResponse.message);\
        await conversationService.saveMessage(\
          conversation.id,\
          'ai',\
          aiResponse.message,\
          aiResponse.confidence\
        );\
      \} else \{\
        await conversationService.escalateConversation(conversation.id, aiResponse.reason);\
        await whatsappService.sendMessage(\
          from,\
          "Let me connect you with our team. They'll respond shortly!"\
        );\
      \}\
\
      logger.info('Message processed successfully', \{ from, confidence: aiResponse.confidence \});\
    \} catch (error) \{\
      logger.error('Error in message processing', \{ from, error \});\
      // Send fallback message\
      await whatsappService.sendMessage(from, "Sorry, I'm having trouble right now. Please try again shortly!");\
    \}\
  \}\
\
  async handleWebhookVerification(req: Request, res: Response) \{\
    // Twilio webhook verification\
    res.status(200).send('OK');\
  \}\
\}\
