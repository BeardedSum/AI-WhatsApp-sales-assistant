\f2\b0\fs26 \cf0 \strokec2 import \{ Entity, PrimaryGeneratedColumn, Column, CreateDateColumn, UpdateDateColumn, OneToMany \} from 'typeorm';\
import \{ Customer \} from './Customer';\
import \{ Product \} from './Product';\
import \{ FAQ \} from './FAQ';\
\
@Entity('businesses')\
export class Business \{\
  @PrimaryGeneratedColumn('uuid')\
  id: string;\
\
  @Column(\{ type: 'varchar', length: 255 \})\
  name: string;\
\
  @Column(\{ type: 'varchar', length: 20, unique: true \})\
  whatsapp_number: string;\
\
  @Column(\{ type: 'varchar', length: 255, unique: true \})\
  owner_email: string;\
\
  @Column(\{ type: 'text', nullable: true \})\
  owner_password_hash: string;\
\
  @Column(\{ type: 'enum', enum: ['friendly', 'formal', 'custom'], default: 'friendly' \})\
  ai_tone: string;\
\
  @Column(\{ type: 'varchar', nullable: true \})\
  knowledge_base_google_drive_folder_id: string;\
\
  @Column(\{ type: 'enum', enum: ['free', 'basic', 'pro'], default: 'free' \})\
  subscription_tier: string;\
\
  @Column(\{ type: 'enum', enum: ['active', 'suspended', 'cancelled'], default: 'active' \})\
  status: string;\
\
  @Column(\{ type: 'text', nullable: true \})\
  location: string;\
\
  @Column(\{ type: 'jsonb', nullable: true \})\
  policies: Record<string, any>; // \{ return_policy: "...", delivery: "..." \}\
\
  @OneToMany(() => Customer, customer => customer.business)\
  customers: Customer[];\
\
  @OneToMany(() => Product, product => product.business)\
  products: Product[];\
\
  @OneToMany(() => FAQ, faq => faq.business)\
  faqs: FAQ[];\
\
  @CreateDateColumn()\
  created_at: Date;\
\
  @UpdateDateColumn()\
  updated_at: Date;\
\}\
