\f2\fs26 \cf0 \strokec2 class ClaudeService \{\
  async generateResponse(params: \{\
    userMessage: string;\
    businessContext: BusinessContext;\
    conversationHistory: Message[];\
    fileSearchResults?: Document[];\
  \}) \{\
    const systemPrompt = this.buildSystemPrompt(params.businessContext);\
    const userPrompt = this.buildUserPrompt(\
      params.userMessage,\
      params.conversationHistory,\
      params.fileSearchResults\
    );\
    \
    const response = await anthropic.messages.create(\{\
      model: 'claude-sonnet-4-5-20250929',\
      max_tokens: 1024,\
      system: systemPrompt,\
      messages: [\
        ...this.formatConversationHistory(params.conversationHistory),\
        \{ role: 'user', content: userPrompt \}\
      ]\
    \});\
    \
    return \{\
      message: response.content[0].text,\
      confidence: this.calculateConfidence(response), // Heuristic\
      usage: response.usage\
    \};\
  \}\
  \
  private buildSystemPrompt(businessContext: BusinessContext): string \{\
    return `\
You are an AI sales assistant for $\{businessContext.name\}.\
\
TONE: $\{businessContext.ai_tone\}\
\
BUSINESS INFO:\
- Location: $\{businessContext.location\}\
- WhatsApp: $\{businessContext.whatsapp_number\}\
- Products: $\{businessContext.products.map(p => `$\{p.name\} - \uc0\u8358 $\{p.price\}`).join(', ')\}\
\
POLICIES:\
$\{businessContext.policies\}\
\
INSTRUCTIONS:\
- Be helpful and friendly\
- Answer product questions accurately\
- Take orders when requested\
- If unsure about anything, say "Let me check with my manager"\
- Never make up product info that isn't in your context\
- Use Nigerian English naturally\
`;\
  \}\
  \
  private calculateConfidence(response): number \{\
    // Simple heuristic - check for uncertainty phrases\
    const uncertainPhrases = [\
      'i\\'m not sure',\
      'let me check',\
      'i don\\'t know',\
      'might be',\
      'possibly'\
    ];\
    \
    const text = response.content[0].text.toLowerCase();\
    const hasUncertainty = uncertainPhrases.some(phrase => text.includes(phrase));\
    \
    return hasUncertainty ? 0.7 : 0.95;\
  \}\
\}\
