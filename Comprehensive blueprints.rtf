\f2\fs26 \cf0 \strokec2 // POST /webhook/whatsapp\
async handleIncomingMessage(req, res) \{\
  // 1. Verify WhatsApp signature (security)\
  if (!verifyWebhookSignature(req)) \{\
    return res.status(403).send('Forbidden');\
  \}\
  \
  // 2. Parse incoming message\
  const \{ from, body, messageId \} = parseWhatsAppPayload(req.body);\
  \
  // 3. Acknowledge immediately (WhatsApp requires 200 within 15s)\
  res.status(200).send('OK');\
  \
  // 4. Process asynchronously\
  processMessageAsync(from, body, messageId);\
\}\
\
async processMessageAsync(from, body, messageId) \{\
  // Load business & conversation context\
  const business = await findBusinessByWhatsAppNumber(from);\
  const conversation = await loadOrCreateConversation(from, business);\
  \
  // Check if escalated\
  if (conversation.escalated_to_human) \{\
    await notifyOwner(business, from, body);\
    return;\
  \}\
  \
  // Send to Google ADK Agent\
  const response = await googleADKAgent.process(\{\
    message: body,\
    conversation_id: conversation.id,\
    business_context: await getBusinessContext(business),\
    conversation_history: await getLastNMessages(conversation.id, 5)\
  \});\
  \
  // Save to DB\
  await saveMessage(conversation.id, 'customer', body);\
  await saveAIInteraction(conversation.id, response);\
  \
  // Send response or escalate\
  if (response.confidence > 0.85) \{\
    await sendWhatsAppMessage(from, response.message);\
    await saveMessage(conversation.id, 'ai', response.message, response.confidence);\
  \} else \{\
    await escalateConversation(conversation.id, response.escalation_reason);\
    await sendWhatsAppMessage(from, "Let me connect you with our team. They'll respond shortly!");\
  \}\
\}\
